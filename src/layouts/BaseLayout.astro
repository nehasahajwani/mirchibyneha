---
import Nav from '../components/Nav.astro';
import { withBase } from '../lib/paths';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = ',by neha — Photography, Videography & Design Portfolio',
  description = 'The photography, videography, and design portfolio of Neha Sahajwani.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="bg-ink text-paper font-body min-h-screen flex flex-col">
    <Nav />
    <main class="flex-1">
      <slot />
    </main>
  </body>
</html>
