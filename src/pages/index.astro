---
import BaseLayout from '../layouts/BaseLayout.astro';
import home from '../data/home.json';
import site from '../data/site.json';
import { withBase } from '../lib/paths';
---

<BaseLayout title=",by neha — Home">
  <div class="mx-auto max-w-[1400px] px-10 lg:px-16">
    <!-- Hero -->
    <section class="pt-2 pb-16 md:pb-24">
      <div class="relative overflow-hidden rounded-sm">
        <img
          src={withBase(home.hero.image)}
          alt={home.hero.alt}
          class="w-full h-[320px] md:h-[520px] object-cover"
        />
        <p class="absolute top-6 left-6 md:top-8 md:left-8 font-display text-2xl md:text-3xl tracking-tight text-paper">
          , by neha
        </p>
      </div>
    </section>

    <!-- About me -->
    <section class="grid grid-cols-1 md:grid-cols-[280px_1fr] gap-6 md:gap-16 pb-28 md:pb-36">
      <h1 class="font-display italic text-4xl md:text-5xl text-paper">
        {home.about.title}
      </h1>
      <p class="font-body font-semibold text-base md:text-lg leading-relaxed max-w-2xl text-paper">
        {home.about.body}
      </p>
    </section>

    <!-- Contact -->
    <section id="contact" class="grid grid-cols-1 md:grid-cols-[280px_1fr] gap-6 md:gap-16 pb-32 md:pb-40">
      <h2 class="font-display italic text-4xl md:text-5xl text-paper">
        Contact
      </h2>
      <div class="flex flex-col gap-4">
        {
          site.contact.links.map((link) => (
            <a
              href={link.href}
              target={link.type === 'instagram' ? '_blank' : undefined}
              rel={link.type === 'instagram' ? 'noopener noreferrer' : undefined}
              class="inline-flex items-center gap-3 font-body font-semibold text-xl md:text-2xl text-paper opacity-90 hover:opacity-100 hover:text-accent transition-colors w-fit"
            >
              {link.type === 'instagram' ? (
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-7 w-7 md:h-8 md:w-8 shrink-0"
                  aria-hidden="true"
                >
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4" />
                  <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none" />
                </svg>
              ) : (
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-7 w-7 md:h-8 md:w-8 shrink-0"
                  aria-hidden="true"
                  >
                    <rect x="2.5" y="4.5" width="19" height="15" rx="2.5" />
                    <path d="M3.5 6 L12 13 L20.5 6" />
                  </svg>
                )}
                {link.label}
              </a>
            ))
          }
      </div>
    </section>
  </div>
</BaseLayout>
