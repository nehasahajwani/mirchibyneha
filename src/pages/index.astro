---
import BaseLayout from '../layouts/BaseLayout.astro';
import home from '../data/home.json';
import { withBase } from '../lib/paths';
---

<BaseLayout title=",by neha — Home">
  <div class="mx-auto max-w-[1400px] px-10 lg:px-16">
    <!-- Hero -->
    <section class="pt-2 pb-16 md:pb-24">
      <div class="relative overflow-hidden rounded-sm">
        <img
          src={withBase(home.hero.image)}
          alt={home.hero.alt}
          class="w-full h-[320px] md:h-[520px] object-cover"
        />
        <p class="absolute top-6 left-6 md:top-8 md:left-8 font-display text-2xl md:text-3xl tracking-tight text-paper">
          ,by neha
        </p>
      </div>
    </section>

    <!-- About me -->
    <section class="grid grid-cols-1 md:grid-cols-[280px_1fr] gap-6 md:gap-16 pb-28 md:pb-36">
      <h1 class="font-display italic text-4xl md:text-5xl text-paper">
        {home.about.title}
      </h1>
      <p class="font-body font-semibold text-base md:text-lg leading-relaxed max-w-2xl text-paper">
        {home.about.body}
      </p>
    </section>

    <!-- Contact (reserved for future content) -->
    <section id="contact" class="pb-32 md:pb-40">
      <h2 class="font-display italic text-4xl md:text-5xl text-paper mb-10">
        Contact
      </h2>
      <div class="min-h-[140px] md:min-h-[200px]" aria-hidden="true"></div>
    </section>
  </div>
</BaseLayout>
